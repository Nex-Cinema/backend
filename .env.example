# Environment variables for Cinema Booking System Backend

# Database
DATABASE_URL=mysql://root:password@localhost:3306/cinema_booking_db

# Server
PORT=5000
NODE_ENV=development
SEED_DEMO_DATA_ON_START=true

# JWT Secrets (change these to strong random strings in production)
ACCESS_TOKEN_SECRET=your_access_token_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here

# JWT Expiry
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# API
API_PREFIX=/api/v1
BACKEND_PUBLIC_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="UIT Cinema <no-reply@uitcinema.com>"

# PayOS Configuration
PAYOS_CLIENT_ID=your_payos_client_id_here
PAYOS_API_KEY=your_payos_api_key_here
PAYOS_CHECKSUM_KEY=your_payos_checksum_key_here
PAYOS_RETURN_URL=http://localhost:5173/profile?payment=success
PAYOS_CANCEL_URL=http://localhost:5173/profile?payment=cancel

# VNPay Sandbox Configuration
VNPAY_TMN_CODE=your_vnpay_sandbox_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_sandbox_hash_secret_here
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_CALLBACK_URL=http://localhost:5000/api/v1/payment/vnpay/return
VNPAY_FRONTEND_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=https://your-public-backend.example.com/api/v1/payment/vnpay/ipn
# Local sandbox only: confirms a valid signed return when VNPay cannot reach localhost IPN.
# Keep false in production; production must use the public HTTPS IPN URL above.
VNPAY_ALLOW_SIGNED_RETURN_CONFIRMATION=false


